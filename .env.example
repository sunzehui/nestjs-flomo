# ===== 运行环境 =====
NODE_ENV = development
# 服务监听端口
port = 3000
# 静态资源（上传的图片）访问前缀，生产环境请填实际域名
SERVER_URL = http://localhost:3000

# ===== JWT =====
# ⚠️ 请务必替换为你自己的长随机字符串，不要使用这里的示例值
JWT_SECRET = please-change-me-to-a-long-random-string
JWT_EXPIRE = 24h

# ===== 跨域 =====
# 允许跨域的来源，多个用英文逗号分隔。
# 留空时：开发环境只放行 localhost:8080 / 5173，生产环境不放行任何来源。
CORS_ORIGINS =

# ===== 数据库 =====
DATABASE_TYPE = sqlite
DATABASE_PATH = src/core/sql/sqlite.db
ENTITIES_PATH = dist/src/**/*.entity{.ts,.js}
MIGRATIONS_PATH = dist/src/core/sql/migration/*{.ts,.js}
# 生产环境务必保持 false，否则会与 migration 冲突
SYNCHRONIZE = false
